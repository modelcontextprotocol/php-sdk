includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - examples/
        - src/
        - tests/
    excludePaths:
        - examples/cli/vendor/* (?)
        - tests/Unit/Server/Capability/Discovery/Fixtures/
        - tests/Unit/Server/Capability/Discovery/SchemaGeneratorFixture.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            identifier: missingType.iterableValue
            path: tests/
