{
    "name": "mcp/server",
    "description": "Model Context Protocol server for PHP applications",
    "license": "Apache-2.0",
    "type": "library",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "ai",
        "server"
    ],
    "homepage": "https://php.sdk.modelcontextprotocol.io",
    "authors": [
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de"
        },
        {
            "name": "Kyrian Obikwelu",
            "email": "koshnawaza@gmail.com"
        },
        {
            "name": "Tobias Nyholm",
            "email": "tobias.nyholm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "mcp/schema": "^0.11",
        "opis/json-schema": "^2.4",
        "php-http/discovery": "^1.20",
        "phpdocumentor/reflection-docblock": "^6.0",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/deprecation-contracts": "^2.5 || ^3.0",
        "symfony/uid": "^5.4 || ^6.4 || ^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Mcp\\Server\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "mcp/sdk",
            "url": "https://github.com/modelcontextprotocol/php-sdk"
        }
    }
}
